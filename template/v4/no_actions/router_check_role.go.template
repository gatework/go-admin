package router

import (
	"github.com/gin-gonic/gin"
	jwt "github.com/gatework/motor-core/jwtauth"

	"github.com/gatework/motor/app/{{.PackageName}}/handler"
	"github.com/gatework/motor/common/middleware"
	"github.com/gatework/motor/common/actions"
)

func init() {
	routerCheckRole = append(routerCheckRole, register{{.ClassName}}Router)
}

// register{{.ClassName}}Router
func register{{.ClassName}}Router(v1 *gin.RouterGroup, authMiddleware *jwt.GinJWTMiddleware) {
	h := handler.{{.ClassName}}{}
	r := v1.Group("/{{.ModuleName}}").Use(authMiddleware.MiddlewareFunc()).Use(middleware.AuthCheckRole())
	{
		r.GET("", actions.PermissionAction(), h.List)
		r.GET("/:id", actions.PermissionAction(), h.Get)
		r.POST("", h.Create)
		r.PUT("/:id", actions.PermissionAction(), h.Update)
		r.DELETE("", h.Delete)
	}
}