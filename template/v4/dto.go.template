type {{.ClassName}}GetReq struct {
	{{- range .Columns -}}
    {{$x := .Pk}}
    {{- if ($x) }}
     {{.GoField}} {{.GoType}} `uri:"id"`
    {{- end }}
    {{- end }}
}
func (s *{{.ClassName}}GetReq) GetId() interface{} {
	return s.{{.PkGoField}}
