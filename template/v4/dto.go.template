// {{.ClassName}}DeleteReq 功能删除请求参数
type {{.ClassName}}DeleteReq struct {
	Ids []{{$pkType}} `json:"ids"`
}

func (s *{{.ClassName}}DeleteReq) GetId() interface{} {
	return s.Ids
}

{{if eq $pkType "int64"}}
// UnmarshalJSON parses each decimal identifier explicitly: json's string option
// does not apply to the elements of an integer slice.
func (s *{{.ClassName}}DeleteReq) UnmarshalJSON(data []byte) error {
    var input struct { Ids []string `json:"ids"` }
    if err := json.Unmarshal(data, &input); err != nil { return err }
    ids := make([]int64, len(input.Ids))
    for i, value := range input.Ids {
        id, err := strconv.ParseInt(value, 10, 64)
        if err != nil { return err }
        ids[i] = id
    }
    s.Ids = ids
    return nil
}
{{end}}
